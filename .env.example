# ⚠️  NE JAMAIS PARTAGER CE FICHIER REMPLI ⚠️
# Si tu penses que ton token a fuité, va sur https://discord.com/developers et régénère-le IMMÉDIATEMENT.

# Token du bot Discord (obligatoire)
# Va sur https://discord.com/developers/applications > ton app > Bot > Token
DISCORD_BOT_TOKEN=ton_token_discord_ici

# Clé API Google Maps / Places (obligatoire)
# Va sur https://console.cloud.google.com > APIs & Services > Credentials
# Active: Places API, Geocoding API
GOOGLE_MAPS_API_KEY=ta_cle_google_ici

# ID du channel Discord où poster les résultats (obligatoire)
# Clic droit sur le channel dans Discord > "Copier l'identifiant du salon"
LEADS_CHANNEL_ID=123456789012345678

# (Optionnel) URL base de données PostgreSQL — si vide, SQLite sera utilisé
# DATABASE_URL=postgresql://user:password@localhost:5432/leads_db

# (Optionnel) Limite de requêtes Google par seconde (défaut: 5)
# RATE_LIMIT_PER_SEC=5

# ID du salon "à appeler" où poster les leads à traiter
# Clic droit sur le channel > "Copier l'identifiant"
CALL_CHANNEL_ID=123456789012345678

# ID Discord de l'associé à mentionner lors des /update
# Clic droit sur son profil > "Copier l'identifiant de l'utilisateur"
ASSOCIATE_USER_ID=123456789012345678

# ─── Nouveaux salons (scoring + call queue + stats + relances) ───

# Salon Call Queue : file d'appels priorisée par score
CALL_QUEUE_CHANNEL_ID=123456789012345678

# Salon Stats : stats automatiques postées périodiquement
STATS_CHANNEL_ID=123456789012345678

# Salon Follow-up : relances automatiques quand une relance est due
FOLLOWUP_CHANNEL_ID=123456789012345678

# Intervalle en minutes entre chaque post de stats (défaut: 10)
# STATS_POST_INTERVAL_MIN=10

# Intervalle en minutes entre chaque vérification de relances (défaut: 60)
# FOLLOWUP_CHECK_INTERVAL_MIN=60

# ─── SMTP Email Outreach ───
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password
SMTP_SECURE=true
FROM_EMAIL=your_email@example.com
FROM_NAME=YourName

# Limite d'emails par minute (défaut: 10)
# EMAIL_RATE_LIMIT_PER_MIN=10

# Heure du post quotidien des stats (format HH:MM, heure Israël, défaut: 21:00)
# DAILY_STATS_TIME=21:00

# (Optionnel) Credentials Google Sheets — TODO pour export Sheets
# GOOGLE_SHEETS_CREDENTIALS=

# ─── Mode Hunt — Détection de demandes web sur tout internet ───────────────
# Clé API SerpAPI (https://serpapi.com) — débloque Instagram, LinkedIn, Twitter, Forums
# Sans cette clé, seul Reddit (gratuit) sera utilisé pour le mode /hunt
# SERP_API_KEY=your_serpapi_key_here
